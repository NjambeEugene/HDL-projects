#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_008D1FA0 .scope module, "shift_register_tb" "shift_register_tb" 2 2;
 .timescale -9 -12;
v008D80E0_0 .var "clock", 0 0;
v008D8138_0 .net "q", 3 0, v01173E70_0; 1 drivers
v008D8190_0 .var "reset", 0 0;
v008DD400_0 .var "serial_in", 0 0;
S_01173D90 .scope module, "uut" "shift_register" 2 6, 3 1, S_008D1FA0;
 .timescale -9 -12;
v01173E18_0 .net "clock", 0 0, v008D80E0_0; 1 drivers
v01173E70_0 .var "q", 3 0;
v008D8030_0 .net "reset", 0 0, v008D8190_0; 1 drivers
v008D8088_0 .net "serial_in", 0 0, v008DD400_0; 1 drivers
E_008D87E8 .event posedge, v01173E18_0;
    .scope S_01173D90;
T_0 ;
    %wait E_008D87E8;
    %load/v 8, v008D8030_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 4, 0;
    %assign/v0 v01173E70_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v008D8088_0, 1;
    %load/v 9, v01173E70_0, 3; Select 3 out of 4 bits
    %ix/load 0, 4, 0;
    %assign/v0 v01173E70_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_008D1FA0;
T_1 ;
    %set/v v008D80E0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/v 8, v008D80E0_0, 1;
    %inv 8, 1;
    %set/v v008D80E0_0, 8, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_008D1FA0;
T_2 ;
    %vpi_call 2 19 "$dumpfile", "shift_register.vcd";
    %vpi_call 2 20 "$dumpvars", 1'sb0, S_008D1FA0;
    %vpi_call 2 22 "$monitor", "Time= %0t| Reset=%b | Serial_in=%b | Output=%b", $time, v008D8190_0, v008DD400_0, v008D8138_0;
    %set/v v008D8190_0, 1, 1;
    %set/v v008DD400_0, 0, 1;
    %delay 10000, 0;
    %set/v v008D8190_0, 0, 1;
    %set/v v008DD400_0, 1, 1;
    %delay 10000, 0;
    %set/v v008DD400_0, 0, 1;
    %delay 10000, 0;
    %set/v v008DD400_0, 1, 1;
    %delay 10000, 0;
    %set/v v008DD400_0, 1, 1;
    %delay 10000, 0;
    %set/v v008DD400_0, 0, 1;
    %delay 10000, 0;
    %delay 20000, 0;
    %vpi_call 2 31 "$finish";
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "Shift_registerTB.v";
    "Shift_register.v";

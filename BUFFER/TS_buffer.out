#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_00FD1F18 .scope module, "tristate_buffer_tb" "tristate_buffer_tb" 2 1;
 .timescale 0 0;
v00FD4548_0 .var "A", 0 0;
v00FD45A0_0 .var "EN", 0 0;
v00FD45F8_0 .net "Y", 0 0, L_00FD4650; 1 drivers
S_00FD1FA0 .scope module, "uut" "tristate_buffer" 2 7, 3 1, S_00FD1F18;
 .timescale 0 0;
v00FD4440_0 .net "A", 0 0, v00FD4548_0; 1 drivers
v010132B0_0 .net "EN", 0 0, v00FD45A0_0; 1 drivers
v01013308_0 .alias "Y", 0 0, v00FD45F8_0;
v01013360_0 .net *"_s0", 0 0, C4<z>; 0 drivers
L_00FD4650 .functor MUXZ 1, C4<z>, v00FD4548_0, v00FD45A0_0, C4<>;
    .scope S_00FD1F18;
T_0 ;
    %vpi_call 2 14 "$dumpfile", "TS_buffer.vcd";
    %vpi_call 2 15 "$dumpvars", 1'sb0, S_00FD1F18;
    %vpi_call 2 16 "$monitor", "Time=%t| A=%b | EN=%b | Y=%b", $time, v00FD4548_0, v00FD45A0_0, v00FD45F8_0;
    %set/v v00FD4548_0, 0, 1;
    %set/v v00FD45A0_0, 0, 1;
    %delay 10, 0;
    %set/v v00FD4548_0, 1, 1;
    %set/v v00FD45A0_0, 0, 1;
    %delay 10, 0;
    %set/v v00FD4548_0, 0, 1;
    %set/v v00FD45A0_0, 1, 1;
    %delay 10, 0;
    %set/v v00FD4548_0, 1, 1;
    %set/v v00FD45A0_0, 1, 1;
    %delay 10, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_0;

#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_010A1F18 .scope module, "piso_tb" "piso_tb" 2 2;
 .timescale -9 -12;
v010AED78_0 .var "clock", 0 0;
v010AEDD0_0 .var "load", 0 0;
v010AEE28_0 .var "parallel_in", 3 0;
v010AEE80_0 .net "q", 3 0, v010E3D48_0; 1 drivers
v010AEED8_0 .var "reset", 0 0;
v010AEF30_0 .net "serial_out", 0 0, v010E3DF8_0; 1 drivers
S_010AAB00 .scope module, "uut" "piso_shift_register" 2 8, 3 2, S_010A1F18;
 .timescale -9 -12;
v010A87F8_0 .net "clock", 0 0, v010AED78_0; 1 drivers
v010A1FA0_0 .net "load", 0 0, v010AEDD0_0; 1 drivers
v010A1FF8_0 .net "parallel_in", 3 0, v010AEE28_0; 1 drivers
v010E3D48_0 .var "q", 3 0;
v010E3DA0_0 .net "reset", 0 0, v010AEED8_0; 1 drivers
v010E3DF8_0 .var "serial_out", 0 0;
E_010A7EA0 .event posedge, v010E3DA0_0, v010A87F8_0;
    .scope S_010AAB00;
T_0 ;
    %wait E_010A7EA0;
    %load/v 8, v010E3DA0_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 4, 0;
    %assign/v0 v010E3D48_0, 0, 0;
    %ix/load 0, 1, 0;
    %assign/v0 v010E3DF8_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v010A1FA0_0, 1;
    %jmp/0xz  T_0.2, 8;
    %load/v 8, v010A1FF8_0, 4;
    %ix/load 0, 4, 0;
    %assign/v0 v010E3D48_0, 0, 8;
    %load/v 8, v010A1FF8_0, 1; Only need 1 of 4 bits
; Save base=8 wid=1 in lookaside.
    %ix/load 0, 1, 0;
    %assign/v0 v010E3DF8_0, 0, 8;
    %jmp T_0.3;
T_0.2 ;
    %load/v 8, v010E3D48_0, 1; Only need 1 of 4 bits
; Save base=8 wid=1 in lookaside.
    %ix/load 0, 1, 0;
    %assign/v0 v010E3DF8_0, 0, 8;
    %load/v 8, v010E3D48_0, 4;
    %ix/load 0, 1, 0;
    %mov 4, 0, 1;
    %shiftr/i0  8, 4;
    %ix/load 0, 4, 0;
    %assign/v0 v010E3D48_0, 0, 8;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_010A1F18;
T_1 ;
    %set/v v010AED78_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/v 8, v010AED78_0, 1;
    %inv 8, 1;
    %set/v v010AED78_0, 8, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_010A1F18;
T_2 ;
    %vpi_call 2 24 "$dumpfile", "Shift_register.vcd";
    %vpi_call 2 25 "$dumpvars", 1'sb0, S_010A1F18;
    %vpi_call 2 26 "$monitor", "Time=%0t | Load=%b | Parallel_in=%b | Q=%b | Serial_out=%b", $time, v010AEDD0_0, v010AEE28_0, v010AEE80_0, v010AEF30_0;
    %set/v v010AEED8_0, 1, 1;
    %set/v v010AEDD0_0, 0, 1;
    %movi 8, 11, 4;
    %set/v v010AEE28_0, 8, 4;
    %delay 10000, 0;
    %set/v v010AEED8_0, 0, 1;
    %set/v v010AEDD0_0, 1, 1;
    %movi 8, 11, 4;
    %set/v v010AEE28_0, 8, 4;
    %delay 10000, 0;
    %set/v v010AEDD0_0, 0, 1;
    %delay 50000, 0;
    %vpi_call 2 40 "$finish";
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "PISO_shift_registerTB.v";
    "PISO_shift_register.v";
